// Who exists, and where they come from. Every `house_id` must name a house in
// houses.ron — checked after all mods have merged, so another mod may supply
// the house.
//
// Ages and treasuries change in play, so they are state: start.state.ron.
//
// Family ties (parent↔child, husband↔wife) live in families.ron.
(
    characters: [
        // House Hightower — Leyton rules Oldtown; Alerie is his wife.
        (id: "char-leyton",   name: "Leyton",   house_id: "house-hightower", sex: m),
        (id: "char-alerie",   name: "Alerie",   house_id: "house-hightower", sex: f),
        (id: "char-baelor",   name: "Baelor",   house_id: "house-hightower", sex: m),
        (id: "char-rhea",     name: "Rhea",     house_id: "house-hightower", sex: f),
        (id: "char-denyse",   name: "Denyse",   house_id: "house-hightower", sex: f),
        (id: "char-gunthor",  name: "Gunthor",  house_id: "house-hightower", sex: m),

        // House Lannister — Tywin rules Lannisport; Joanna is his wife.
        (id: "char-tywin",    name: "Tywin",    house_id: "house-lannister", sex: m),
        (id: "char-jaime",    name: "Jaime",    house_id: "house-lannister", sex: m),
        (id: "char-cersei",   name: "Cersei",   house_id: "house-lannister", sex: f),
