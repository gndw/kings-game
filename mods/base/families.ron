// Family ties between characters — parent/child links and spousal links. One
// entry per relation: a child's parents produce one entry, a marriage produces
// one. The ECS turns these into `CharacterHasFather` / `CharacterHasMother` /
// `CharacterHasHusband` / `CharacterHasWife` and auto-maintained reverse Vecs
// on the parents.
//
// A character not named here is unlinked — `validate` rejects any id this file
// references that the loaded characters don't define.
(
    families: [
        // ----- House Hightower: Leyton × Alerie -----
        // The ruling couple.
        (id: "fam-mar-leyton-alerie",   type: Marriage, husband_character_id: "char-leyton", wife_character_id: "char-alerie"),
        // Their four children.
        (id: "fam-baelor",   type: Family, child_character_id: "char-baelor",  father_character_id: "char-leyton",  mother_character_id: "char-alerie"),
        (id: "fam-rhea",     type: Family, child_character_id: "char-rhea",    father_character_id: "char-leyton",  mother_character_id: "char-alerie"),
        (id: "fam-denyse",   type: Family, child_character_id: "char-denyse",  father_character_id: "char-leyton",  mother_character_id: "char-alerie"),
        (id: "fam-gunthor",  type: Family, child_character_id: "char-gunthor", father_character_id: "char-leyton",  mother_character_id: "char-alerie"),

        // ----- House Lannister: Tywin × Joanna -----
        (id: "fam-mar-tywin-joanna",    type: Marriage, husband_character_id: "char-tywin", wife_character_id: "char-joanna"),
        (id: "fam-jaime",   type: Family, child_character_id: "char-jaime",  father_character_id: "char-tywin", mother_character_id: "char-joanna"),
        (id: "fam-cersei",  type: Family, child_character_id: "char-cersei", father_character_id: "char-tywin", mother_character_id: "char-joanna"),
        (id: "fam-tyrion",  type: Family, child_character_id: "char-tyrion", father_character_id: "char-tywin", mother_character_id: "char-joanna"),

        // ----- House Arryn: Jon × Jeyne -----
        (id: "fam-mar-jon-jeyne",       type: Marriage, husband_character_id: "char-jon", wife_character_id: "char-jeyne"),
        (id: "fam-lysa",    type: Family, child_character_id: "char-lysa",   father_character_id: "char-jon", mother_character_id: "char-jeyne"),
        (id: "fam-elbert",  type: Family, child_character_id: "char-elbert", father_character_id: "char-jon", mother_character_id: "char-jeyne"),
        (id: "fam-aemma",   type: Family, child_character_id: "char-aemma",  father_character_id: "char-jon", mother_character_id: "char-jeyne"),

        // ----- House Tully: Hoster × Minisa -----
        (id: "fam-mar-hoster-minisa",   type: Marriage, husband_character_id: "char-hoster", wife_character_id: "char-minisa"),
        (id: "fam-edmure",  type: Family, child_character_id: "char-edmure",  father_character_id: "char-hoster", mother_character_id: "char-minisa"),
        (id: "fam-catelyn", type: Family, child_character_id: "char-catelyn", father_character_id: "char-hoster", mother_character_id: "char-minisa"),
        (id: "fam-lysara",  type: Family, child_character_id: "char-lysara",  father_character_id: "char-hoster", mother_character_id: "char-minisa"),

        // ----- House Tyrell: Luthor × Olenna -----
        (id: "fam-mar-luthor-olenna",   type: Marriage, husband_character_id: "char-luthor", wife_character_id: "char-olenna"),
        (id: "fam-mace",     type: Family, child_character_id: "char-mace",     father_character_id: "char-luthor", mother_character_id: "char-olenna"),
        (id: "fam-willas",   type: Family, child_character_id: "char-willas",   father_character_id: "char-luthor", mother_character_id: "char-olenna"),
        (id: "fam-garlan",   type: Family, child_character_id: "char-garlan",   father_character_id: "char-luthor", mother_character_id: "char-olenna"),
        (id: "fam-margaery", type: Family, child_character_id: "char-margaery", father_character_id: "char-luthor", mother_character_id: "char-olenna"),

        // ----- House Martell: Doran × Mellario -----
        (id: "fam-mar-doran-mellario",  type: Marriage, husband_character_id: "char-doran", wife_character_id: "char-mellario"),
        (id: "fam-arianne",  type: Family, child_character_id: "char-arianne",  father_character_id: "char-doran", mother_character_id: "char-mellario"),
        (id: "fam-quentyn",  type: Family, child_character_id: "char-quentyn",  father_character_id: "char-doran", mother_character_id: "char-mellario"),
        (id: "fam-trystane", type: Family, child_character_id: "char-trystane", father_character_id: "char-doran", mother_character_id: "char-mellario"),

        // ----- Cross-house marriage: Hightower × Lannister -----
        (id: "fam-mar-baelor-cersei",   type: Marriage, husband_character_id: "char-baelor", wife_character_id: "char-cersei"),

        // ----- Cross-house marriage: Tyrell × Arryn -----
        (id: "fam-mar-willas-aemma",    type: Marriage, husband_character_id: "char-willas", wife_character_id: "char-aemma"),

        // ----- House Hightower: dead ancestors & dead descendant -----
        // Bors's marriage to Dalla produced Leyton. Leyton × Alerie produced the
        // late Brynden (dead in his teens), in addition to the four living children above.
        (id: "fam-mar-bors-dalla",      type: Marriage, husband_character_id: "char-bors", wife_character_id: "char-dalla"),
        (id: "fam-leyton-anc",         type: Family, child_character_id: "char-leyton",     father_character_id: "char-bors",     mother_character_id: "char-dalla"),
        (id: "fam-brynden-hi",         type: Family, child_character_id: "char-brynden-hi", father_character_id: "char-leyton",   mother_character_id: "char-alerie"),

        // ----- House Lannister: dead ancestors & dead descendant -----
        // Tytos × Jeyne produced Tywin. Tywin × Joanna produced the late
        // Steffon (dead of fever), in addition to the twins and Tyrion above.
        (id: "fam-mar-tytos-jeyne",     type: Marriage, husband_character_id: "char-tytos", wife_character_id: "char-jeyne-ln"),
        (id: "fam-tywin-anc",          type: Family, child_character_id: "char-tywin",     father_character_id: "char-tytos",    mother_character_id: "char-jeyne-ln"),
        (id: "fam-steffon",            type: Family, child_character_id: "char-steffon",   father_character_id: "char-tywin",    mother_character_id: "char-joanna"),

        // ----- House Arryn: dead ancestors & dead descendant -----
        // Isembard × Alyssa produced Jon. Jon × Jeyne produced the late
        // Artys (killed in a hunting accident), in addition to the three living children above.
        (id: "fam-mar-isembard-alyssa", type: Marriage, husband_character_id: "char-isembard", wife_character_id: "char-alyssa"),
        (id: "fam-jon-anc",            type: Family, child_character_id: "char-jon",       father_character_id: "char-isembard", mother_character_id: "char-alyssa"),
        (id: "fam-artys",              type: Family, child_character_id: "char-artys",     father_character_id: "char-jon",      mother_character_id: "char-jeyne"),

        // ----- House Tully: dead ancestors & dead descendant -----
        // Edmyn × Lysbeth produced Hoster. Hoster × Minisa produced the late
        // Leo (drowned as a boy), in addition to Edmure, Catelyn, and Lysara above.
        (id: "fam-mar-edmyn-lysbeth",   type: Marriage, husband_character_id: "char-edmyn",   wife_character_id: "char-lysbeth"),
        (id: "fam-hoster-anc",         type: Family, child_character_id: "char-hoster",    father_character_id: "char-edmyn",    mother_character_id: "char-lysbeth"),
        (id: "fam-leo",                type: Family, child_character_id: "char-leo",       father_character_id: "char-hoster",   mother_character_id: "char-minisa"),

        // ----- House Tyrell: dead ancestors & dead descendant -----
        // Moryn × Alannys produced Luthor. Luthor × Olenna produced the late
        // Quentyn (killed in a tourney melee), in addition to Mace, Willas, Garlan, and Margaery above.
        (id: "fam-mar-moryn-alannys",   type: Marriage, husband_character_id: "char-moryn",   wife_character_id: "char-alannys"),
        (id: "fam-luthor-anc",         type: Family, child_character_id: "char-luthor",    father_character_id: "char-moryn",    mother_character_id: "char-alannys"),
        (id: "fam-quentyn-ty",         type: Family, child_character_id: "char-quentyn-ty", father_character_id: "char-luthor",  mother_character_id: "char-olenna"),

        // ----- House Martell: dead ancestors & dead descendant -----
        // Qorell × Meria produced Doran. Doran × Mellario produced the late
        // Olyvar (ambushed in the Boneway), in addition to Arianne, Quentyn, and Trystane above.
        (id: "fam-mar-qorell-meria",    type: Marriage, husband_character_id: "char-qorell",  wife_character_id: "char-meria"),
        (id: "fam-doran-anc",          type: Family, child_character_id: "char-doran",     father_character_id: "char-qorell",   mother_character_id: "char-meria"),
        (id: "fam-olyvar",             type: Family, child_character_id: "char-olyvar",    father_character_id: "char-doran",    mother_character_id: "char-mellario"),
    ],
)
