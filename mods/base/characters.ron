// Who exists, and where they come from. Every `house_id` must name a house in
// houses.ron — checked after all mods have merged, so another mod may supply
// the house.
//
// Ages and treasuries change in play, so they are state: start.state.ron.
(
    characters: [
        (id: "char-leyton",  name: "leyton",  house_id: "house-hightower"),
        (id: "char-alerie",  name: "alerie",  house_id: "house-hightower"),
        (id: "char-tywin",   name: "tywin",   house_id: "house-lannister"),
        (id: "char-jaime",   name: "jaime",   house_id: "house-lannister"),
        (id: "char-jon",     name: "jon",     house_id: "house-arryn"),
        (id: "char-lysa",    name: "lysa",    house_id: "house-arryn"),
    ],
)
