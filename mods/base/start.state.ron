    // Pre-existing memories. These describe gifts the recipient already
    // received before the game opens — the opinion_of helper adds their
    // contribution so long as today < until_date. A fresh gift is blocked
    // while any active ReceivedGold memory remains on the recipient.
    memories: [
        // Mara remembers Markel's wedding gift of 25 gold, +25 opinion for 5 years.
        (id: "memory-mara-markel-wedding",
         character_id: "char-mara",
         toward_character_id: "char-markel",
         created_date: (year: 1064, month: 6, day: 1),
         until_date: (year: 1069, month: 6, day: 1),
         kind: ReceivedGold(amount: 25)),

        // Lorian remembers Olwen's gift of 50 gold, +50 opinion for 10 years.
        (id: "memory-lorian-olwen",
         character_id: "char-lorian",
         toward_character_id: "char-olwen",
         created_date: (year: 1060, month: 1, day: 1),
         until_date: (year: 1070, month: 1, day: 1),
         kind: ReceivedGold(amount: 50)),

        // Tybalt gifted 50 gold to Maren (leader of kingdom-riversmeet)
        // as a diplomatic gesture dated 1065.6.1 — ~7 months before game open
        // (1066.1.1) so the +50 opinion boost is live at start and lasts ~9.4 years.
        (id: "memory-maren-tybalt-gift",
         character_id: "char-maren",
         toward_character_id: "char-tybalt",
         created_date: (year: 1065, month: 6, day: 1),
         until_date: (year: 1075, month: 6, day: 1),
         kind: ReceivedGold(amount: 50)),
    ],

    // Event popup: the first popup fires on day 90 of year 1066 (April 1) —
    // ~3 in-game months after the calendar's `start`. The resolver rewrites
    // this every time an event resolves or the player forfeits, so it's the
    // single source of truth for "when does the next popup trigger?".
    event_deck: (
        next_due_date: (year: 1066, month: 2, day: 1),
    ),
)