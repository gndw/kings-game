// What a holding can raise. Military ones cost upkeep and add levy; civil
// ones earn the gold that pays for them. One gold field each, never both.
(
    buildings: [
        // military — quarters and drills the levy, earns nothing
        (id: "building-barracks",      name: "barracks",       gold_upkeep: 5, levy: 50),
        (id: "building-stables",       name: "stables",        gold_upkeep: 4, levy: 40),
        (id: "building-training-yard", name: "training yard",   gold_upkeep: 3, levy: 30),
        (id: "building-archery-range", name: "archery range",   gold_upkeep: 2, levy: 20),
        (id: "building-watchtower",    name: "watchtower",      gold_upkeep: 1, levy: 10),
        // civil — no troops, but the coin that pays for them
        (id: "building-vineyard",      name: "vineyard",        gold_profit:  3),
        (id: "building-wharf",         name: "fishing wharf",   gold_profit:  4),
        (id: "building-tannery",       name: "tannery",         gold_profit:  5),
        (id: "building-mill",          name: "grain mill",      gold_profit:  6),
        (id: "building-brewery",       name: "brewery",         gold_profit:  7),
        (id: "building-quarry",        name: "stone quarry",    gold_profit:  8),
        (id: "building-smithy",        name: "smithy",          gold_profit:  9),
        (id: "building-market",        name: "market square",   gold_profit: 10),
        (id: "building-lumber-camp",   name: "lumber camp",     gold_profit: 11),
        (id: "building-guildhall",     name: "guildhall",       gold_profit: 12),
    ],
)
