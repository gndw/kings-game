        (id: "char-lancel",   name: "Lancel",   house_id: "house-lannister", sex: m),

        // House Arryn — Jon rules Gulltown; Jeyne is his wife.
        (id: "char-jon",      name: "Jon",      house_id: "house-arryn",     sex: m),
        (id: "char-lysa",     name: "Lysa",     house_id: "house-arryn",     sex: f),
        (id: "char-jeyne",    name: "Jeyne",    house_id: "house-arryn",     sex: f),
        (id: "char-elbert",   name: "Elbert",   house_id: "house-arryn",     sex: m),
        (id: "char-aemma",    name: "Aemma",    house_id: "house-arryn",     sex: f),
        (id: "char-alaric",   name: "Alaric",   house_id: "house-arryn",     sex: m),

        // House Tully — Minisa rules Riverrun; Hoster is her husband.
        (id: "char-minisa",   name: "Minisa",   house_id: "house-tully",     sex: f),
        (id: "char-edmure",   name: "Edmure",   house_id: "house-tully",     sex: m),
