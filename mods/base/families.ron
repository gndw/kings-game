// Constant family ties — entries that name ONLY dead characters. Their data
// never changes in play, so it belongs in this read-only constants file
// (which a save file will never include).
//
// Any family that names an alive character lives in start.state.ron instead,
// because the alive char's identity is state-only — putting the family here
// would make it dangle before state has loaded.
//
// Each entry is one relation: a child's parents produce one entry, a
// marriage produces one. The ECS turns these into `CharacterHasFather` /
// `CharacterHasMother` / `CharacterHasHusband` / `CharacterHasWife` and
// auto-maintained reverse Vecs on the parents.
//
// A character not named here is unlinked — `validate` rejects any id this
// file references that the loaded characters don't define.
(
    families: [
        // ----- Dead ancestor marriages (parents of the ruling generation) -----
        // Bordan × Dalla (Cresswell) → produced Aldric.
        (id: "fam-mar-bordan-dalla",    type: Marriage, husband_character_id: "char-bordan", wife_character_id: "char-dalla"),

        // Torin × Jeyne (Aurelan) → produced Tybalt.
        (id: "fam-mar-torin-jeyne-au",  type: Marriage, husband_character_id: "char-torin", wife_character_id: "char-jeyne-au"),

        // Ingrey × Alessia (Selwyn) → produced Jorell.
        (id: "fam-mar-ingrey-alessia",  type: Marriage, husband_character_id: "char-ingrey",  wife_character_id: "char-alessia"),

        // Edwyn × Elspeth (Darrowmont) → produced Halric.
        (id: "fam-mar-edwyn-elspeth",   type: Marriage, husband_character_id: "char-edwyn",   wife_character_id: "char-elspeth"),

        // Morian × Alanna (Margaux) → produced Lorian.
        (id: "fam-mar-morian-alanna",   type: Marriage, husband_character_id: "char-morian",  wife_character_id: "char-alanna"),

        // Qorell × Meria (Corvin) → produced Dorian.
        (id: "fam-mar-qorell-meria",    type: Marriage, husband_character_id: "char-qorell",  wife_character_id: "char-meria"),
    ],
)