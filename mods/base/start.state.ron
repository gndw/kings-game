        (id: "char-qorell",    dob: (year:  978, month: 1, day: 1)),
        (id: "char-meria",     dob: (year:  984, month: 1, day: 1)),
        (id: "char-olyvar",    dob: (year: 1045, month: 1, day: 1)),
