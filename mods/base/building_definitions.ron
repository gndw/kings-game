// The building catalogue: read-only definitions for every kind of building.
// Military ones cost upkeep and add levy; civil ones earn the gold that pays
// for them. One gold field each, never both.
//
// `construction_price` is the one-off gold cost to build one of these. Balanced
// as a rough rule of thumb: civil = gold_profit × 10, military = levy + gold_upkeep × 5
// — stronger buildings cost more, weak ones are cheap.
(
    buildings: [
        // military — quarters and drills the levy, earns nothing
        (id: "building-barracks",      name: "barracks",       gold_upkeep: 5, levy: 50, construction_price:  75),
        (id: "building-stables",       name: "stables",        gold_upkeep: 4, levy: 40, construction_price:  60),
        (id: "building-training-yard", name: "training yard",   gold_upkeep: 3, levy: 30, construction_price:  45),
        (id: "building-archery-range", name: "archery range",   gold_upkeep: 2, levy: 20, construction_price:  30),
        (id: "building-watchtower",    name: "watchtower",      gold_upkeep: 1, levy: 10, construction_price:  15),
        // civil — no troops, but the coin that pays for them
        (id: "building-vineyard",      name: "vineyard",        gold_profit:  3, construction_price:  30),
        (id: "building-wharf",         name: "fishing wharf",   gold_profit:  4, construction_price:  40),
        (id: "building-tannery",       name: "tannery",         gold_profit:  5, construction_price:  50),
        (id: "building-mill",          name: "grain mill",      gold_profit:  6, construction_price:  60),
        (id: "building-brewery",       name: "brewery",         gold_profit:  7, construction_price:  70),
        (id: "building-quarry",        name: "stone quarry",    gold_profit:  8, construction_price:  80),
        (id: "building-smithy",        name: "smithy",          gold_profit:  9, construction_price:  90),
        (id: "building-market",        name: "market square",   gold_profit: 10, construction_price: 100),
        (id: "building-lumber-camp",   name: "lumber camp",     gold_profit: 11, construction_price: 110),
        (id: "building-guildhall",     name: "guildhall",       gold_profit: 12, construction_price: 120),
    ],
)
