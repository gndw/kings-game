        // House Tully — dead ancestors of Hoster.
        (id: "char-edmyn",    name: "Edmyn",    house_id: "house-tully",     gender: m, is_alive: false, death_date: (year: 1036, month: 7, day: 22)),
        (id: "char-lysbeth",  name: "Lysbeth",  house_id: "house-tully",     gender: f, is_alive: false, death_date: (year: 1044, month: 3, day: 11)),

        // House Tully — dead descendant of Hoster & Minisa (first son, drowned in the Tumblestone as a boy).
        (id: "char-leo",      name: "Leo",      house_id: "house-tully",     gender: m, is_alive: false, death_date: (year: 1050, month: 8, day: 3)),

        // House Tyrell — Olenna rules the Reach; Luthor is her husband.
        (id: "char-olenna",   name: "Olenna",   house_id: "house-tyrell",    gender: f),
        (id: "char-mace",     name: "Mace",     house_id: "house-tyrell",    gender: m),
        (id: "char-luthor",   name: "Luthor",   house_id: "house-tyrell",    gender: m),
        (id: "char-willas",   name: "Willas",   house_id: "house-tyrell",    gender: m),
        (id: "char-garlan",   name: "Garlan",   house_id: "house-tyrell",    gender: m),
        (id: "char-margaery", name: "Margaery", house_id: "house-tyrell",    gender: f),

        // House Tyrell — dead ancestors of Luthor.
        (id: "char-moryn",    name: "Moryn",    house_id: "house-tyrell",    gender: m, is_alive: false, death_date: (year: 1034, month: 6, day: 4)),
