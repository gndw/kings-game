// Where the world starts. Everything here changes in play — who rules what,
// what stands in each land, what's in a treasury — so this is the half that a
// save file will hold, and the half the sim writes back into.
//
// Any `*.state.ron` in a mod folder is one of these. The other `*.ron` files
// are definitions: read-only data, only ever added to.
//
// Entries are an overlay keyed by id. Anything the content defines and this
// file doesn't mention gets a default, and anything here that names content
// nobody declares is dropped with a line in the chronicle. That's what lets an
// old save load against a game that has grown since — new lands and new
// characters simply start where their own mod says they do.
(
    kingdoms: [
        (id: "kingdom-west",        leader_character_id: "char-leyton", land_id: "land-2"),
        (id: "kingdom-centre",      leader_character_id: "char-tywin",  land_id: "land-3"),
        (id: "kingdom-east",        leader_character_id: "char-jon",    land_id: "land-5"),
        (id: "kingdom-riverlands",  leader_character_id: "char-minisa", land_id: "land-1"),
        (id: "kingdom-reach",       leader_character_id: "char-olenna", land_id: "land-4"),
        (id: "kingdom-dorne",       leader_character_id: "char-doran",  land_id: "land-6"),
    ],
    // Each built building is its own instance: a unique `id`, the `def_id` of
    // the building kind it is (an entry in building_definitions.ron), and the
    // `land_id` it stands on. These become building entities in the ECS, each
    // related to its land.
    buildings: [
        // land-1 (Westwatch)
        (id: "b-1-1", def_id: "building-tannery",     land_id: "land-1", status: Active),
        (id: "b-1-2", def_id: "building-wharf",       land_id: "land-1", status: Active),
        (id: "b-1-3", def_id: "building-vineyard",    land_id: "land-1", status: Active),
        (id: "b-1-4", def_id: "building-watchtower",  land_id: "land-1", status: Active),
        // land-2 (Oldtown)
        (id: "b-2-1", def_id: "building-mill",          land_id: "land-2", status: Active),
        (id: "b-2-2", def_id: "building-smithy",        land_id: "land-2", status: Active),
        (id: "b-2-3", def_id: "building-vineyard",      land_id: "land-2", status: Active),
        (id: "b-2-4", def_id: "building-archery-range", land_id: "land-2", status: Active),
        // land-3 (Lannisport)
        (id: "b-3-1", def_id: "building-guildhall", land_id: "land-3", status: Active),
        (id: "b-3-2", def_id: "building-market",    land_id: "land-3", status: Active),
        (id: "b-3-3", def_id: "building-barracks",  land_id: "land-3", status: Active),
        (id: "b-3-4", def_id: "building-stables",   land_id: "land-3", status: Active),
        // land-4 (Riverrun)
        (id: "b-4-1", def_id: "building-brewery",       land_id: "land-4", status: Active),
        (id: "b-4-2", def_id: "building-smithy",        land_id: "land-4", status: Active),
        (id: "b-4-3", def_id: "building-barracks",      land_id: "land-4", status: Active),
        (id: "b-4-4", def_id: "building-training-yard", land_id: "land-4", status: Active),
        // land-5 (Gulltown)
        (id: "b-5-1", def_id: "building-quarry",   land_id: "land-5", status: Active),
        (id: "b-5-2", def_id: "building-tannery",  land_id: "land-5", status: Active),
        (id: "b-5-3", def_id: "building-wharf",    land_id: "land-5", status: Active),
        (id: "b-5-4", def_id: "building-stables",  land_id: "land-5", status: Active),
        // land-6 (Duskendale)
        (id: "b-6-1", def_id: "building-lumber-camp",   land_id: "land-6", status: Active),
        (id: "b-6-2", def_id: "building-market",        land_id: "land-6", status: Active),
        (id: "b-6-3", def_id: "building-archery-range", land_id: "land-6", status: Active),
        (id: "b-6-4", def_id: "building-watchtower",    land_id: "land-6", status: Active),
    ],
    courtiers: [
        (id: "courtier-alerie", kingdom_id: "kingdom-west", character_id: "char-alerie", type: Courtier),
        (id: "courtier-jaime", kingdom_id: "kingdom-centre", character_id: "char-jaime", type: Courtier),
        (id: "courtier-lysa", kingdom_id: "kingdom-east", character_id: "char-lysa", type: Courtier),
        (id: "courtier-edmure", kingdom_id: "kingdom-riverlands", character_id: "char-edmure", type: Courtier),
        (id: "courtier-mace", kingdom_id: "kingdom-reach", character_id: "char-mace", type: Courtier),
        (id: "courtier-oberyn", kingdom_id: "kingdom-dorne", character_id: "char-oberyn", type: Courtier),
    ],
    // Levy and gold_yield are left out on purpose: the sim recomputes both at
    // `new_game`, so writing them here would only ever be wrong.
    characters: [
        (id: "char-leyton", age: 61, gold: 42),
        (id: "char-alerie", age: 34, gold: 8),
        (id: "char-tywin",  age: 57, gold: 35),
        (id: "char-jaime",  age: 29, gold: 13),
        (id: "char-jon",    age: 66, gold: 27),
        (id: "char-lysa",   age: 32, gold: 6),
        (id: "char-minisa", age: 50, gold: 20),
        (id: "char-edmure", age: 23, gold: 10),
        (id: "char-olenna", age: 75, gold: 30),
        (id: "char-mace",   age: 40, gold: 15),
        (id: "char-doran",  age: 55, gold: 25),
        (id: "char-oberyn", age: 38, gold: 12),
    ],
)
