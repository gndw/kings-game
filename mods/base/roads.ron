// Connections between adjacent lands, west to east. Each road is a polyline:
// point 1 = western land's holding, last point = eastern land's holding.
// `between_land_ids` lists the two lands the road joins. Roads through
// Lannisport's belly have extra intermediate points so they bend slightly
// instead of running dead straight; the other roads stay at 3 points.
(
    roads: [
        (id: "road-1-2", points: [(330, 345),  (540.0, 390.0),  (750, 435)],   between_land_ids: ["land-1", "land-2"]),
        // through Lannisport's belly: 5 points, gentle southward dip
        (id: "road-2-3", points: [(750, 435),  (970, 540),  (1170, 630), (1300, 675), (1440, 720)],  between_land_ids: ["land-2", "land-3"]),
        // leaving Lannisport into Riverrun: 5 points, slight northward kink
        (id: "road-3-4", points: [(1440, 720), (1510, 755), (1570, 795), (1630, 840), (1680, 870)], between_land_ids: ["land-3", "land-4"]),
        (id: "road-4-5", points: [(1680, 870), (1890.0, 1065.0),(2100, 1260)], between_land_ids: ["land-4", "land-5"]),
        (id: "road-5-6", points: [(2100, 1260),(2212.5, 1297.5),(2325, 1335)], between_land_ids: ["land-5", "land-6"]),
    ],
)
