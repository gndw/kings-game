// Who exists, and where they come from. Every `house_id` must name a house in
// houses.ron — checked after all mods have merged, so another mod may supply
// the house.
//
// Ages and treasuries change in play, so they are state: start.state.ron.
//
// Family ties (parent↔child, husband↔wife) live in families.ron.
(
    characters: [
        // House Hightower — Leyton rules Oldtown; Alerie is his wife.
        (id: "char-leyton",   name: "Leyton",   house_id: "house-hightower", gender: m),
        (id: "char-alerie",   name: "Alerie",   house_id: "house-hightower", gender: f),
        (id: "char-baelor",   name: "Baelor",   house_id: "house-hightower", gender: m),
        (id: "char-rhea",     name: "Rhea",     house_id: "house-hightower", gender: f),
        (id: "char-denyse",   name: "Denyse",   house_id: "house-hightower", gender: f),
        (id: "char-gunthor",  name: "Gunthor",  house_id: "house-hightower", gender: m),

        // House Hightower — dead ancestors of Leyton.
        (id: "char-bors",     name: "Bors",     house_id: "house-hightower", gender: m, is_alive: false, death_date: (year: 1049, month: 4, day: 7)),
        (id: "char-dalla",    name: "Dalla",    house_id: "house-hightower", gender: f, is_alive: false, death_date: (year: 1044, month: 8, day: 22)),

        // House Hightower — dead descendant of Leyton (elder son, died in his teens).
        (id: "char-brynden-hi", name: "Brynden",   house_id: "house-hightower", gender: m, is_alive: false, death_date: (year: 1058, month: 6, day: 15)),

        // House Lannister — Tywin rules Lannisport; Joanna is his wife.
        (id: "char-tywin",    name: "Tywin",    house_id: "house-lannister", gender: m),
        (id: "char-jaime",    name: "Jaime",    house_id: "house-lannister", gender: m),
        (id: "char-cersei",   name: "Cersei",   house_id: "house-lannister", gender: f),
        (id: "char-tyrion",   name: "Tyrion",   house_id: "house-lannister", gender: m),
        (id: "char-joanna",   name: "Joanna",   house_id: "house-lannister", gender: f),
        (id: "char-lancel",   name: "Lancel",   house_id: "house-lannister", gender: m),

        // House Lannister — dead ancestors of Tywin.
        (id: "char-tytos",    name: "Tytos",    house_id: "house-lannister", gender: m, is_alive: false, death_date: (year: 1054, month: 2, day: 11)),
        (id: "char-jeyne-ln", name: "Jeyne",    house_id: "house-lannister", gender: f, is_alive: false, death_date: (year: 1051, month: 10, day: 30)),

        // House Lannister — dead descendant of Tywin (second son, fever).
        (id: "char-steffon",  name: "Steffon",  house_id: "house-lannister", gender: m, is_alive: false, death_date: (year: 1063, month: 11, day: 12)),

        // House Arryn — Jon rules Gulltown; Jeyne is his wife.
        (id: "char-jon",      name: "Jon",      house_id: "house-arryn",     gender: m),
        (id: "char-lysa",     name: "Lysa",     house_id: "house-arryn",     gender: f),
        (id: "char-jeyne",    name: "Jeyne",    house_id: "house-arryn",     gender: f),
        (id: "char-elbert",   name: "Elbert",   house_id: "house-arryn",     gender: m),
        (id: "char-aemma",    name: "Aemma",    house_id: "house-arryn",     gender: f),
        (id: "char-alaric",   name: "Alaric",   house_id: "house-arryn",     gender: m),

        // House Arryn — dead ancestors of Jon.
        (id: "char-isembard", name: "Isembard", house_id: "house-arryn",     gender: m, is_alive: false, death_date: (year: 1037, month: 5, day: 9)),
        (id: "char-alyssa",   name: "Alyssa",   house_id: "house-arryn",     gender: f, is_alive: false, death_date: (year: 1043, month: 9, day: 14)),

        // House Arryn — dead descendant of Jon (first son, hunting accident).
        (id: "char-artys",    name: "Artys",    house_id: "house-arryn",     gender: m, is_alive: false, death_date: (year: 1065, month: 8, day: 11)),

        // House Tully — Minisa rules Riverrun; Hoster is her husband.
        (id: "char-minisa",   name: "Minisa",   house_id: "house-tully",     gender: f),
        (id: "char-edmure",   name: "Edmure",   house_id: "house-tully",     gender: m),
