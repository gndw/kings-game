        (id: "fam-mar-bors-cerelia",    type: Marriage, husband_character_id: "char-bors", wife_character_id: "char-cerelia"),
        (id: "fam-mar-wendell-aemma",   type: Marriage, husband_character_id: "char-wendell", wife_character_id: "char-aemma"),
    ],
    // Alive characters — full records here, including identity (name, house,
    // gender, skills). The sim rewrites the mutable fields (gold, levy,
    // death date, etc.) during play and will write them back into a save.
    //
    // Levy and gold_yield are left out on purpose: the sim recomputes both at
    // `new_game`, so writing them here would only ever be wrong.
    // `dob` is the character's date of birth. The starting ages live here as
    // `calendar.start.year - dob.year`, so a mod that picks a different
    // opening year doesn't need to recompute anyone's birthday.
    characters: [
        (id: "char-aldric", name: "Aldric", house_id: "house-cresswell", gender: m, skills: (martial:  8, prowess:  6, treasury: 14, prudence: 18, intrigue: 10, faith: 12), dob: (year: 1005, month: 1, day: 1), gold: 42, next_death_event_date: (year: 1066, month: 8, day: 7)),
        (id: "char-mara",   name: "Mara",   house_id: "house-cresswell", gender: f, skills: (martial:  4, prowess:  4, treasury:  8, prudence: 12, intrigue:  8, faith: 14), dob: (year: 1032, month: 1, day: 1), gold: 8,  next_death_event_date: (year: 1067, month: 7, day: 30)),
        (id: "char-bors",   name: "Bors",   house_id: "house-cresswell", gender: m, skills: (martial: 12, prowess: 14, treasury: 10, prudence: 10, intrigue:  8, faith: 10), dob: (year: 1029, month: 1, day: 1), gold: 18, next_death_event_date: (year: 1068, month: 7, day: 13)),
        (id: "char-rhael",  name: "Rhael",  house_id: "house-cresswell", gender: f, skills: (martial:  6, prowess:  6, treasury:  8, prudence: 14, intrigue: 10, faith: 12), dob: (year: 1032, month: 1, day: 1), gold: 9,  next_death_event_date: (year: 1067, month: 4, day: 25)),
        (id: "char-denyse", name: "Denyse", house_id: "house-cresswell", gender: f, skills: (martial:  4, prowess:  4, treasury:  6, prudence: 10, intrigue:  8, faith: 14), dob: (year: 1035, month: 1, day: 1), gold: 7,  next_death_event_date: (year: 1068, month: 2, day: 17)),
        (id: "char-gunthor",name: "Gunthor",house_id: "house-cresswell", gender: m, skills: (martial: 10, prowess: 12, treasury:  8, prudence:  8, intrigue:  6, faith: 10), dob: (year: 1038, month: 1, day: 1), gold: 11, next_death_event_date: (year: 1068, month: 11, day: 3)),

