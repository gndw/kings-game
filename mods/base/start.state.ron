        (id: "b-5-4", def_id: "building-stables",  land_id: "land-5", status: Active),
        (id: "b-5-5", def_id: "building-castle",   land_id: "land-5", status: Active),
        // land-6 (Sun's End)
        (id: "b-6-1", def_id: "building-lumber-camp",   land_id: "land-6", status: Active),
        (id: "b-6-2", def_id: "building-market",        land_id: "land-6", status: Active),
