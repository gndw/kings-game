// Map data — edit freely, loaded on next start. Override the path with KINGS_MAP.
// `border` is the rectangular map edge; every land in `lands` sits inside it.
// Each land is a polyline: consecutive points are joined by a line.
//
// One long island running south-west to north-east: a thin hooked tail in the west,
// a wider belly in the middle, a broad lobed head in the north-east. Five inland
// borders cut it into six; each is shared point-for-point by its neighbours.
(
    // the edge of the world; the camera never pans past it
    border: (x0: 0, y0: 40, x1: 860, y1: 540),
    lands: [
        // far west: the tip of the tail, out past the (180, ...) cut
        (id: "land-1", name: "westwatch", holding: (110, 115), borders: [
            (180, 155), (130, 145), (80, 140), (40, 110),
            (80, 80), (130, 95), (180, 115),
            (180, 155),
        ], building_ids: [
            "building-tannery", "building-wharf", "building-vineyard",
            "building-watchtower",
        ]),
        // west: the rest of the tail, up to the belly border
        (id: "land-2", name: "oldtown", holding: (250, 145), borders: [
            (320, 185), (280, 170), (230, 150), (180, 155),
            (180, 115), (230, 125), (280, 130), (320, 140),
            (318, 155), (322, 170), (320, 185),
        ], building_ids: [
            "building-mill", "building-smithy", "building-vineyard",
            "building-archery-range",
        ]),
        // centre-west: the lower belly
        (id: "land-3", name: "lannisport", holding: (480, 240), borders: [
            (320, 185), (360, 215), (390, 250), (420, 275), (450, 300),
            (470, 330),
            (540, 190), (510, 170), (480, 150), (450, 140), (420, 120),
            (390, 135), (360, 150), (320, 140),
            (318, 155), (322, 170), (320, 185),
        ], building_ids: [
            "building-guildhall", "building-market",
            "building-barracks", "building-stables",
        ]),
        // centre-east: the upper belly, up to the head border
        (id: "land-4", name: "riverrun", holding: (560, 290), borders: [
            (470, 330), (500, 350), (540, 375), (570, 400), (600, 420), (640, 445),
            (628, 400), (645, 350), (660, 300),
            (630, 290), (600, 265), (580, 240), (560, 215), (540, 190),
            (470, 330),
        ], building_ids: [
            "building-brewery", "building-smithy",
            "building-barracks", "building-training-yard",
        ]),
        // north-east: the head, west of the lobe cut
        (id: "land-5", name: "gulltown", holding: (700, 420), borders: [
            (640, 445), (670, 465), (700, 480), (740, 470),
            (760, 395), (730, 375), (700, 350), (690, 320), (660, 300),
            (645, 350), (628, 400), (640, 445),
        ], building_ids: [
            "building-quarry", "building-tannery", "building-wharf",
            "building-stables",
        ]),
        // east: the coastal lobe on the far side of the head
        (id: "land-6", name: "duskendale", holding: (775, 445), borders: [
            (740, 470), (770, 485), (800, 460), (810, 430), (790, 405),
            (760, 395),
            (740, 470),
        ], building_ids: [
            "building-lumber-camp", "building-market",
            "building-archery-range", "building-watchtower",
        ]),
    ],
    // What a holding can raise. Military ones cost upkeep and add levy; civil
    // ones earn the gold that pays for them. One gold field each, never both.
    buildings: [
        // military — quarters and drills the levy, earns nothing
        (id: "building-barracks",      name: "barracks",       gold_upkeep: 5, levy: 50),
        (id: "building-stables",       name: "stables",        gold_upkeep: 4, levy: 40),
        (id: "building-training-yard", name: "training yard",   gold_upkeep: 3, levy: 30),
        (id: "building-archery-range", name: "archery range",   gold_upkeep: 2, levy: 20),
        (id: "building-watchtower",    name: "watchtower",      gold_upkeep: 1, levy: 10),
        // civil — no troops, but the coin that pays for them
        (id: "building-vineyard",      name: "vineyard",        gold_profit:  3),
        (id: "building-wharf",         name: "fishing wharf",   gold_profit:  4),
        (id: "building-tannery",       name: "tannery",         gold_profit:  5),
        (id: "building-mill",          name: "grain mill",      gold_profit:  6),
        (id: "building-brewery",       name: "brewery",         gold_profit:  7),
        (id: "building-quarry",        name: "stone quarry",    gold_profit:  8),
        (id: "building-smithy",        name: "smithy",          gold_profit:  9),
        (id: "building-market",        name: "market square",   gold_profit: 10),
        (id: "building-lumber-camp",   name: "lumber camp",     gold_profit: 11),
        (id: "building-guildhall",     name: "guildhall",       gold_profit: 12),
    ],
    // the families; characters belong to one, kingdoms are ruled by one of them
    houses: [
        (id: "house-hightower", name: "hightower"),
        (id: "house-lannister", name: "lannister"),
        (id: "house-arryn",     name: "arryn"),
    ],
    characters: [
        (id: "char-leyton",  name: "leyton",  house_id: "house-hightower", age: 61),
        (id: "char-alerie",  name: "alerie",  house_id: "house-hightower", age: 34),
        (id: "char-tywin",   name: "tywin",   house_id: "house-lannister", age: 57),
        (id: "char-jaime",   name: "jaime",   house_id: "house-lannister", age: 29),
        (id: "char-jon",     name: "jon",     house_id: "house-arryn",     age: 66),
        (id: "char-lysa",    name: "lysa",    house_id: "house-arryn",     age: 32),
    ],
    // who holds what. The seat is the capital and must also appear in `land_ids`.
    kingdoms: [
        (id: "kingdom-west",   leader_character_id: "char-leyton", seat_land_id: "land-2",
         land_ids: ["land-1", "land-2"]),
        (id: "kingdom-centre", leader_character_id: "char-tywin",  seat_land_id: "land-3",
         land_ids: ["land-3", "land-4"]),
        (id: "kingdom-east",   leader_character_id: "char-jon",    seat_land_id: "land-5",
         land_ids: ["land-5", "land-6"]),
    ],
)
