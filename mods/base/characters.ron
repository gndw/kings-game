        (id: "char-quentyn-ty", name: "Quentyn", house_id: "house-tyrell",  gender: m, is_alive: false, death_date: (year: 1063, month: 4, day: 7)),

        // House Martell — Doran rules Dorne; Mellario is his wife.
        (id: "char-doran",    name: "Doran",    house_id: "house-martell",   gender: m),
        (id: "char-oberyn",   name: "Oberyn",   house_id: "house-martell",   gender: m),
        (id: "char-mellario", name: "Mellario", house_id: "house-martell",   gender: f),
        (id: "char-arianne",  name: "Arianne",  house_id: "house-martell",   gender: f),
        (id: "char-quentyn",  name: "Quentyn",  house_id: "house-martell",   gender: m),
        (id: "char-trystane", name: "Trystane", house_id: "house-martell",   gender: m),

        // House Martell — dead ancestors of Doran.
        (id: "char-qorell",   name: "Qorell",   house_id: "house-martell",   gender: m, is_alive: false, death_date: (year: 1049, month: 5, day: 2)),
        (id: "char-meria",    name: "Meria",    house_id: "house-martell",   gender: f, is_alive: false, death_date: (year: 1036, month: 3, day: 1)),

