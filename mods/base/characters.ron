        (id: "char-brynden",  name: "Brynden",  house_id: "house-tully",     sex: m),
        (id: "char-catelyn",  name: "Catelyn",  house_id: "house-tully",     sex: f),
        (id: "char-lysara",   name: "Lysara",   house_id: "house-tully",     sex: f),

        // House Tyrell — Olenna rules the Reach; Luthor is her husband.
        (id: "char-olenna",   name: "Olenna",   house_id: "house-tyrell",    sex: f),
        (id: "char-mace",     name: "Mace",     house_id: "house-tyrell",    sex: m),
